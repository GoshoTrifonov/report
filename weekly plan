              <>
                <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Update File
              </>
            )}
            <input type="file" accept=".xlsm,.xlsx" className="hidden" onChange={onFileInput} />
          </label>
        </div>
      </div>

      {uploadError && (
        <div className="bg-red-900/60 border border-red-700 text-red-200 text-sm px-6 py-3">
          ⚠ {uploadError}
        </div>
      )}

      {/* Controls */}
      <div className="px-6 py-3 bg-gray-900/50 border-b border-gray-800 flex items-center gap-3 flex-wrap">
        <input
          type="text"
          placeholder="Search resource, part ID, or description…"
          value={search}
          onChange={e => setSearch(e.target.value)}
          className="flex-1 min-w-48 bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-blue-500"
        />
        <div className="flex rounded-lg overflow-hidden border border-gray-700">
          <button
            onClick={() => setViewMode("week")}
            className={`px-3 py-2 text-sm font-medium transition-colors ${viewMode === "week" ? "bg-blue-600 text-white" : "bg-gray-800 text-gray-400 hover:text-gray-100"}`}
          >
            Week View
          </button>
          <button
            onClick={() => setViewMode("table")}
            className={`px-3 py-2 text-sm font-medium transition-colors ${viewMode === "table" ? "bg-blue-600 text-white" : "bg-gray-800 text-gray-400 hover:text-gray-100"}`}
          >
            Multi-Week
          </button>
        </div>
      </div>

      {/* Week selector (for Week View) */}
      {viewMode === "week" && (
        <div className="px-6 py-3 bg-gray-900/30 border-b border-gray-800">
          <div className="flex items-center gap-2 flex-wrap">
            <span className="text-xs text-gray-500 font-medium uppercase tracking-wider">Week of:</span>
            {allWeeks.map(w => (
              <button
                key={w}
                onClick={() => setSelectedWeek(w)}
                className={`text-xs px-3 py-1.5 rounded-full border transition-colors ${
                  w === currentWeek
                    ? "bg-blue-600 border-blue-500 text-white font-semibold"
                    : w === defaultWeek
                    ? "bg-gray-800 border-blue-800 text-blue-300 hover:border-blue-500"
                    : "bg-gray-800 border-gray-700 text-gray-400 hover:text-gray-100 hover:border-gray-500"
                }`}
              >
                {fmtWeek(w)}
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Content */}
      <div className="flex-1 overflow-auto p-6">
        {viewMode === "week" ? (
          <WeekView rows={weekRows} week={currentWeek} />
        ) : (
          <TableView rows={filtered} weeks={visibleWeeks} allWeeks={allWeeks} />
        )}
      </div>
    </div>
  );
}

function WeekView({ rows, week }) {
  if (rows.length === 0) {
    return (
      <div className="text-center text-gray-500 py-20">
        No build plan quantities for week of {fmtWeek(week)}.
      </div>
    );
  }

  const total = rows.reduce((s, r) => s + (r.weeks[week] || 0), 0);

  return (
    <div>
      <div className="flex items-center justify-between mb-4">
        <div className="text-gray-400 text-sm">
          <span className="text-white font-semibold">{rows.length}</span> parts scheduled ·{" "}
          <span className="text-white font-semibold">{total.toLocaleString()}</span> total units
        </div>
      </div>
      <div className="grid gap-2">
        {rows.map(r => (
          <div key={r.part_id} className="bg-gray-900 border border-gray-800 rounded-xl px-5 py-3 flex items-center justify-between gap-4">
            <div className="min-w-0">
              <div className="text-white font-medium text-sm truncate">{r.description || r.part_id}</div>
              <div className="text-gray-500 text-xs mt-0.5 flex gap-3">
                <span>{r.resource}</span>
                <span className="text-gray-700">·</span>
                <span>{r.part_id}</span>
              </div>
            </div>
            <div className="text-right shrink-0">
              <div className="text-2xl font-bold text-blue-400">{fmtQty(r.weeks[week])}</div>
              <div className="text-gray-600 text-xs">units</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}

function TableView({ rows, weeks, allWeeks }) {
  const [showAll, setShowAll] = useState(false);
  const displayWeeks = showAll ? allWeeks : weeks;

  if (rows.length === 0) {
    return <div className="text-center text-gray-500 py-20">No results match your search.</div>;
  }

  return (
    <div>
      <div className="flex items-center justify-between mb-3 flex-wrap gap-2">
        <div className="text-gray-400 text-sm">
          Showing <span className="text-white font-semibold">{rows.length}</span> parts ·{" "}
          <span className="text-white font-semibold">{displayWeeks.length}</span> weeks
        </div>
        <button
          onClick={() => setShowAll(v => !v)}
          className="text-xs text-blue-400 hover:text-blue-300 border border-gray-700 hover:border-gray-600 px-3 py-1.5 rounded-lg transition-colors"
        >
          {showAll ? "Show near-term only" : `Show all ${allWeeks.length} weeks`}
        </button>
      </div>
      <div className="overflow-x-auto rounded-xl border border-gray-800">
        <table className="min-w-full text-sm border-collapse">
          <thead>
            <tr className="bg-gray-900 text-gray-400 text-xs uppercase tracking-wider">
              <th className="sticky left-0 z-10 bg-gray-900 px-4 py-3 text-left font-semibold whitespace-nowrap border-b border-r border-gray-800 min-w-48">Part</th>
              <th className="sticky left-48 z-10 bg-gray-900 px-4 py-3 text-left font-semibold whitespace-nowrap border-b border-r border-gray-800 min-w-36">Resource</th>
              {displayWeeks.map(w => (
                <th key={w} className="px-3 py-3 text-center font-semibold whitespace-nowrap border-b border-gray-800 min-w-20">
                  {fmtWeek(w)}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((r, i) => (
              <tr key={r.part_id} className={`border-b border-gray-800/50 ${i % 2 === 0 ? "bg-gray-950" : "bg-gray-900/40"} hover:bg-gray-800/50 transition-colors`}>
                <td className="sticky left-0 z-10 px-4 py-3 border-r border-gray-800 min-w-48" style={{ background: i % 2 === 0 ? "#030712" : "rgba(17,24,39,0.4)" }}>
                  <div className="text-gray-100 font-medium text-xs leading-tight truncate max-w-44">{r.description || r.part_id}</div>
                  <div className="text-gray-600 text-xs mt-0.5 truncate">{r.part_id}</div>
                </td>
                <td className="sticky left-48 z-10 px-4 py-3 border-r border-gray-800 min-w-36 text-gray-400 text-xs truncate max-w-36" style={{ background: i % 2 === 0 ? "#030712" : "rgba(17,24,39,0.4)" }}>
                  {r.resource}
                </td>
                {displayWeeks.map(w => {
                  const qty = r.weeks[w];
                  return (
                    <td key={w} className="px-3 py-3 text-center whitespace-nowrap">
                      {qty != null ? (
                        <span className="text-blue-300 font-semibold">{fmtQty(qty)}</span>
                      ) : (
                        <span className="text-gray-800">—</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
